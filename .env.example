# 运行环境
NODE_ENV=production
PORT=5000

# 对外域名（HTTPS）。CORS、站点地图、Bot 内回调都用它
APP_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com
API_URL=https://your-domain.com
CORS_ORIGIN=https://your-domain.com

# MongoDB（密码只放环境变量 / PM2，不要提交 Git）
# MONGODB_URI=mongodb://user:password@127.0.0.1:27017/easypay?authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017/easypay

# 登录会话（至少 16 位，生产必须改掉默认值）
JWT_SECRET=change-me-to-a-long-random-string

# 钱包私钥加密主密钥。丢失则热钱包密文无法解密。生成：npm run generate-key
ENCRYPTION_KEY=

# 可选
RATE_LIMIT_MAX=300

# 仅初始化数据库时使用（npm run init-db）
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=请改成强密码
# SITE_NAME=可可代付
# FORCE_RESET=1
